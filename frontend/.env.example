# Where `npm run dev` forwards /api requests (the Laravel backend).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Production: leave empty when the app is served from the same origin as the API,
# otherwise set the API origin, e.g. https://api.example.com
VITE_API_URL=

# Live seat maps: the same key as REVERB_APP_KEY in the backend. Leave empty to refresh on a timer instead.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
